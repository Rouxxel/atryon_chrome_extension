{
    "defaults": {
        "general_data_path": "../data/general_data.json",
        "api_title": "Atryon Backend",
        "api_version": "1.0.0",
        "api_description": "Backend system for Atryon extension"
    },
    "logging": {
        "logging_level": "debug",
        "dir_name": "logs",
        "log_file_name": "atryon_bcknd"
    },
    "email_validation": {
        "allowed_providers": ["gmail","outlook","yahoo","hotmail","icloud","protonmail","aol","zoho","gmx","mail"],
        "allowed_tlds": ["com","org","net","co","io","edu","gov"]
    },
    "network": {
        "uvicorn_app_reference": "main:app",
        "server_port": 8000,
        "host": "0.0.0.0",
        "reload": false,
        "workers": 1,
        "proxy_headers": true
    },
    "endpoints": {
        "root_directory_endpoint": {
            "request_limit": 25,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "",
            "endpoint_tag": "root",
            "endpoint_route": "/"
        },

        "mic_endpoint": {
            "request_limit": 4,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/ai_gen_edit",
            "endpoint_tag": "ai_gen_edit",
            "endpoint_route": "/mic"
        },
        "idwm_endpoint": {
            "request_limit": 4,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/ai_gen_edit",
            "endpoint_tag": "ai_gen_edit",
            "endpoint_route": "/idwm"
        },
        "tti_endpoint": {
            "request_limit": 4,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/ai_gen_edit",
            "endpoint_tag": "ai_gen_edit",
            "endpoint_route": "/tti"
        },
        "polling_requests_endpoint": {
            "request_limit": 30,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/ai_gen_edit",
            "endpoint_tag": "ai_gen_edit",
            "endpoint_route": "/polling_requests"
        },
        "download_requests_endpoint": {
            "request_limit": 30,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/ai_gen_edit",
            "endpoint_tag": "ai_gen_edit",
            "endpoint_route": "/download_requests"
        }
    }
}