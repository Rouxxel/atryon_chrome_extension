# REST API Template Environment Variables
# Copy this file to .env.local for local development

# AI provider API keys
BFL_API_KEY="key_here"

# Security Keys for encryption
E_PRIVATE_KEY=your_private_key_here
E_PRIVATE_PASSWORD=your_private_password_here
E_PUBLIC_KEY=your_public_key_here

# Data related keys
DB_LINK="link_here"
DB_PUBLIC_KEY="key_here"
DB_SERVICE_KEY="key_here"

